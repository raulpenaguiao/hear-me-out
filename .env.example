# Ouve Isto — environment variables
#
# Copy to .env.local for local development (or run `npm run env:local`, which
# fills in the local Supabase keys and generates fresh secrets for you).
# Placeholder values only. NEVER commit real credentials.

# --- Application -------------------------------------------------------------
# Public origin used in shared links, RSS feeds and enclosure URLs.
# On Vercel previews it may be omitted (falls back to the deployment URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Project URL and anon/publishable key (safe to expose, but only used server-side here).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# Service role / secret key. SERVER ONLY. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Secret link tokens --------------------------------------------------------
# HMAC key for hashing channel tokens (>= 32 random chars): openssl rand -base64 48
# Changing it invalidates every existing channel link.
TOKEN_HASH_SECRET=replace-with-at-least-32-random-characters
# AES-256-GCM key (32 bytes, base64) used to let owners view their links again:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# --- Audio storage -------------------------------------------------------------
# "r2" (production) or "local" (development/tests only; refused on Vercel).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage

# Cloudflare R2 (S3-compatible). Required when STORAGE_DRIVER=r2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional custom S3 endpoint (e.g. MinIO for testing). Defaults to
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=

# "proxy" streams audio through the app (default, bucket never exposed);
# "redirect" answers enclosure requests with a 302 to a 1-hour presigned R2 URL.
AUDIO_DELIVERY_MODE=proxy

# --- Limits ------------------------------------------------------------------
AUDIO_MAX_UPLOAD_MB=200
AUDIO_MAX_DURATION_MINUTES=180
COVER_MAX_UPLOAD_MB=5
UPLOAD_URL_TTL_SECONDS=900

# --- Rate limiting -------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Trust X-Forwarded-For (true on Vercel / behind a trusted proxy).
TRUST_PROXY_HEADERS=true
